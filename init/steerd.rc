# steerd.rc — запуск движка steer под Android init.
#
# Это порт start_service из OpenWrt-скрипта files/etc/init.d/steer на язык init.rc. На
# роутере procd читает спеку и поднимает по экземпляру на каждый выход (vless, xsteer, obfs,
# zapret, tgws); в init.rc так нельзя — сервисы объявляются статически, а состав выходов
# известен только из спеки во время работы. Поэтому здесь заведены только процессы, которые
# есть при ЛЮБОЙ настройке: применение правил, резолвер доменов, сторож устройств и снимок
# состояния. Помощники отдельных выходов (свой туннель) поднимает launcher — см. TODO ниже.
#
# Пути отличаются от роутера и заданы сборкой через -DSTEER_ANDROID:
#   спека   /data/misc/steer/spec.json   (на роутере /etc/steer/spec.json)
#   состояние /data/misc/steer/state     (на роутере /var/lib/steer, tmpfs)
#   времянки /data/misc/steer/tmp        (на роутере /tmp)
# На роутере /var — ссылка в tmpfs, снимок состояния во флеш не пишется. На Android /data
# постоянный, поэтому снимок ложится туда же, но это редкая запись (раз в пять минут), флешу
# телефона это ничего не стоит.

# Каталоги создаём в post-fs-data: до этого /data не смонтирован. Владелец root и режим 0700
# — читать конфиг и сокет может только сам демон и (через SELinux) splify2, а не любой, кто
# знает путь. SELinux-метку steerd_data_file на эти каталоги ставит file_contexts.
on post-fs-data
    mkdir /data/misc/steer 0700 root root
    mkdir /data/misc/steer/state 0700 root root
    mkdir /data/misc/steer/tmp 0700 root root
    restorecon_recursive /data/misc/steer

# Применение правил — разовое действие при загрузке, после того как поднялась сеть. Класс
# late_start и `oneshot`: это не демон, он собирает набор правил, отдаёт его ядру через nft и
# завершается. Держать его в живых нечему — правила остаются в ядре сами.
#
# disabled + запуск по свойству: пока persist.der.steer.enabled != 1, движок не трогает сеть.
service steerd-apply /system_ext/bin/der/steer apply --spec /data/misc/steer/spec.json
    class late_start
    user root
    group root net_admin net_raw inet
    capabilities NET_ADMIN NET_RAW NET_BIND_SERVICE
    seclabel u:r:steerd:s0
    oneshot
    disabled

# Резолвер доменных каналов. Долгоживущий: слушает DNS и подменяет ответ на служебный адрес
# из 198.18.0.0/15, ядро возвращает настоящий через DNAT. На роутере он поднимается только
# при наличии доменных каналов (steer needs-dnsd); здесь он тоже проверяет это сам и выходит
# кодом 0, если доменных каналов нет, — тогда init его просто не перезапускает без нужды.
service steerd-dnsd /system_ext/bin/der/steer dnsd --spec /data/misc/steer/spec.json
    class late_start
    user root
    group root net_admin net_raw inet
    capabilities NET_ADMIN NET_RAW NET_BIND_SERVICE
    seclabel u:r:steerd:s0
    disabled

# Сторож устройств. На роутере это `while :; do steer failover; sleep 60; done` отдельным
# экземпляром procd. Здесь то же самое, но период сна движок знает сам и не будит устройство
# таймером: под STEER_ANDROID сторож проверяет выходы по событиям (смена сети, отказ трафика,
# включение экрана), а не по будильнику — это требование владельца о батарее и сне. Пока
# событийная модель в движке не готова, сторож ходит по мягкому периоду; см. README.
service steerd-failover /system_ext/bin/der/steer failover --loop --spec /data/misc/steer/spec.json
    class late_start
    user root
    group root net_admin net_raw inet
    capabilities NET_ADMIN NET_RAW
    seclabel u:r:steerd:s0
    disabled

# Снимок состояния для splify2 (что и на роутере — steer status раз в N секунд). Отдельным
# сервисом, а не вторым делом в стороже: падение одного не уносит другой, и каждый виден в
# `dumpsys`/логах под своим именем.
service steerd-status /system_ext/bin/der/steer status --loop --spec /data/misc/steer/spec.json
    class late_start
    user root
    group root net_admin net_raw inet
    seclabel u:r:steerd:s0
    disabled

# Включение по свойству. splify2 (или человек через него) ставит persist.der.steer.enabled=1
# — и init поднимает применение правил, затем демоны. Порядок здесь важен так же, как на
# роутере: apply ставит правила (при on_fail=drop — запрет, пока туннеля нет), а резолвер и
# сторож работают уже поверх них. apply — oneshot, поэтому запускается первым и завершается,
# остальные встают следом.
on property:persist.der.steer.enabled=1
    start steerd-apply
    start steerd-dnsd
    start steerd-failover
    start steerd-status

# Выключение: снимаем демонов. Снятие самих правил из ядра — отдельная команда движка
# (`steer down`, если есть) или перезагрузка; init только гасит процессы. Это осознанно: как
# и на роутере, перезапуск демона НЕ снимает правила, чтобы не открыть трафик в момент
# перезапуска.
on property:persist.der.steer.enabled=0
    stop steerd-status
    stop steerd-failover
    stop steerd-dnsd

# TODO (следующий этап, требует решения владельца и mbedtls в дереве):
#   * помощники выходов kind=vless/xsteer/obfs/zapret/tgws. Они спека-зависимы (по одному на
#     выход) и создают TUN до apply. В init.rc их статически не объявить — нужен launcher
#     (oneshot-сервис со скриптом, который читает `steer outputs` и поднимает помощников как
#     дочерние процессы под тем же доменом steerd). Пока не сделано: базовый режим
#     (маршрутизация доменов/адресов в уже поднятый туннель WireGuard) в них не нуждается.
#   * дедицированный uid AID_STEER вместо root. Сейчас демон root, но заперт доменом steerd;
#     на Android изоляцию даёт домен, а не uid, поэтому это улучшение, а не обязательное
#     условие. Заводить AID — правка android_filesystem_config.h, отдельным коммитом.
