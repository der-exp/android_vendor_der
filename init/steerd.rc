# steerd.rc — запуск движка steer под Android init.
#
# Это порт start_service из OpenWrt-скрипта files/etc/init.d/steer на язык init.rc. На
# роутере procd читает спеку и поднимает по экземпляру на каждый выход (vless, xsteer, obfs,
# zapret, tgws); в init.rc так нельзя — сервисы объявляются статически, а состав выходов
# известен только из спеки во время работы. Поэтому здесь заведены только процессы, которые
# есть при ЛЮБОЙ настройке: применение правил, резолвер доменов, сторож устройств и снятие
# правил при выключении, а помощников отдельных выходов (свой туннель) — сервис steerd-outputs.
#
# Пути отличаются от роутера и заданы сборкой через -DSTEER_ANDROID:
#   спека   /data/misc/steer/spec.json   (на роутере /etc/steer/spec.json)
#   состояние /data/misc/steer/state     (на роутере /var/lib/steer, tmpfs)
#   времянки /data/misc/steer/tmp        (на роутере /tmp)
# На роутере /var — ссылка в tmpfs, снимок состояния во флеш не пишется. На Android /data
# постоянный, поэтому состояние (реестр меток, выбранные устройства, fake-IP резолвера)
# ложится туда же.

# Каталоги создаём в post-fs-data: до этого /data не смонтирован. Владелец root и режим 0700
# — читать конфиг и сокет может только сам демон и (через SELinux) splify2, а не любой, кто
# знает путь. SELinux-метку steerd_data_file на эти каталоги ставит file_contexts.
on post-fs-data
    mkdir /data/misc/steer 0700 root root
    mkdir /data/misc/steer/state 0700 root root
    mkdir /data/misc/steer/tmp 0700 root root
    restorecon_recursive /data/misc/steer

# Применение правил — разовое действие при загрузке, после того как поднялась сеть. Класс
# late_start и `oneshot`: это не демон, он собирает набор правил, отдаёт его ядру через nft и
# завершается. Держать его в живых нечему — правила остаются в ядре сами.
#
# disabled + запуск по свойству: пока persist.der.steer.enabled != 1, движок не трогает сеть.
service steerd-apply /system_ext/bin/der/steer apply --spec /data/misc/steer/spec.json
    class late_start
    user root
    group root net_admin net_raw inet
    capabilities NET_ADMIN NET_RAW NET_BIND_SERVICE
    seclabel u:r:steerd:s0
    oneshot
    disabled

# Резолвер доменных каналов. Долгоживущий: слушает DNS и подменяет ответ на служебный адрес
# из 198.18.0.0/15, ядро возвращает настоящий через DNAT. Поднимается при любой спеке, как и
# на роутере (steer needs-dnsd отвечает «поднимать» всегда): перенаправление DNS стоит в
# правилах всегда, и резолвер, к которому оно ведёт, обязан существовать вместе с ним.
# Выходит он только при отказе — и тогда init перезапускает его, как любой не-oneshot сервис.
#
# --upstream-origdst: наверху у резолвера на телефоне никого нет (на 127.0.0.1:53 никто не
# слушает), поэтому каждый запрос уходит к тому серверу, к которому шёл до заворота, — адрес
# берётся из conntrack. Для раздачи это dnsmasq тетеринга, для приложений — серверы текущей
# сети, которые знает только DnsResolver.
service steerd-dnsd /system_ext/bin/der/steer dnsd --spec /data/misc/steer/spec.json --upstream-origdst
    class late_start
    user root
    group root net_admin net_raw inet
    capabilities NET_ADMIN NET_RAW NET_BIND_SERVICE
    seclabel u:r:steerd:s0
    disabled

# Помощники выходов со своим процессом: клиент VLESS/Reality, xsteer, обфускатор, мост
# Telegram. Их состав зависит от спеки, а сервисы init объявлены статически, поэтому держит их
# один сервис — `steer supervise` (перезапуск упавшего через 5 с, падающего сразу — с растущей
# паузой до 5 минут; SIGHUP — сверить состав со спекой). Помощники исполняются в том же домене
# steerd, что и движок.
service steerd-outputs /system_ext/bin/der/steer supervise --spec /data/misc/steer/spec.json
    class late_start
    user root
    group root net_admin net_raw inet
    capabilities NET_ADMIN NET_RAW NET_BIND_SERVICE
    seclabel u:r:steerd:s0
    disabled

# Сторож устройств. На роутере это `while :; do steer failover; sleep 60; done` отдельным
# экземпляром procd. Здесь круг крутит сам движок (`--loop 60`): у init нет строки shell, а
# выдать домену steerd /system/bin/sh значило бы разрешить ему любую команду. Каждый проход —
# отдельный процесс, как в круге procd.
#
# Батарея: сон между проходами — на CLOCK_MONOTONIC, который во сне устройства стоит и не
# будит его; wakelock сторож не берёт. Пока телефон спит, сторож молчит. Проверка по событиям
# (смена сети, включение экрана) вместо периода — следующий шаг; см. README.
service steerd-failover /system_ext/bin/der/steer failover --loop 60 --spec /data/misc/steer/spec.json
    class late_start
    user root
    group root net_admin net_raw inet
    capabilities NET_ADMIN NET_RAW
    seclabel u:r:steerd:s0
    disabled

# Снятие правил при выключении — разовое действие, как и применение. `steer down` удаляет
# таблицы движка во всех раскладках (inet, ip и ip6 старого ядра, обфускаторы) и снимает
# ip rule и маршруты выходов по реестру в /data/misc/steer/state.
service steerd-down /system_ext/bin/der/steer down --state-dir /data/misc/steer/state
    class late_start
    user root
    group root net_admin inet
    capabilities NET_ADMIN
    seclabel u:r:steerd:s0
    oneshot
    disabled

# Снимка состояния по кругу (на роутере — `steer status` раз в N секунд для splify2) здесь
# нет: каждый полный `steer status` и так запоминает свой ответ, а читателя у снимка на
# телефоне пока нет — канал splify2 к движку (сокет steerd_socket) ещё не сделан. Круг без
# читателя — это пересчёт каждые N секунд, пока экран включён, ради файла, который никто не
# открывает.

# Включение по свойству. splify2 (или человек через него) ставит persist.der.steer.enabled=1
# — и init поднимает применение правил, затем демоны. Порядок здесь важен так же, как на
# роутере: apply ставит правила (при on_fail=drop — запрет, пока туннеля нет), а резолвер и
# сторож работают уже поверх них. apply — oneshot, поэтому запускается первым и завершается,
# остальные встают следом.
on property:persist.der.steer.enabled=1
    start steerd-outputs
    start steerd-apply
    start steerd-dnsd
    start steerd-failover

# Выключение: гасим демонов и снимаем правила. Перезапуск демона правил нарочно не трогает
# (открыть трафик на мгновение перезапуска хуже, чем подержать правила), но выключение —
# другое: резолвер погашен насовсем, и заворот DNS на его порт, оставшись в ядре, лишил бы
# имён всех, чей DNS заворачивался; blackhole выхода с on_fail=drop держал бы трафик
# закрытым без видимой причины.
on property:persist.der.steer.enabled=0
    stop steerd-failover
    stop steerd-dnsd
    stop steerd-outputs
    start steerd-down

# Дальше (не сделано): выделенный uid AID_STEER вместо root. Сейчас демон root, но заперт
# доменом steerd; на Android изоляцию даёт домен, а не uid, поэтому это улучшение, а не
# обязательное условие. Правка android_filesystem_config.h, отдельным коммитом.
