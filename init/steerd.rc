# steerd.rc — запуск движка steer под Android init.
#
# С steer 1.8 движок — один демон, steerd: управляющий сокет, применение правил, сторож
# выходов, страж правил, супервизор помощников и резолвер доменов (его ребёнок). Раньше это были
# шесть служб init, и порядок между ними приходилось выстраивать свойствами; теперь порядок —
# забота демона (первый проход сторожа — после стартового применения), а init только держит
# демон живым и сообщает ему о выключателе. steer — маленький клиент сокета, steer-tools —
# ссылка на steerd (роль по argv[0]).
#
# Пути отличаются от роутера и заданы платформой android движка (src/platform/android.c,
# умолчание сборки -DSTEER_DEFAULT_PLATFORM=android в Android.bp):
#   спека   /data/misc/steer/spec.json   (на роутере /etc/steer/spec.json)
#   состояние /data/misc/steer/state     (на роутере /var/lib/steer, tmpfs)
#   времянки /data/misc/steer/tmp        (на роутере /tmp)
# На роутере /var — ссылка в tmpfs, снимок состояния во флеш не пишется. На Android /data
# постоянный, поэтому состояние (реестр меток, выбранные устройства, fake-IP резолвера)
# ложится туда же.

# Каталоги создаём в post-fs-data: до этого /data не смонтирован. Корень — 0711: обходить его
# может любой uid, читать список — только root. Обход нужен приложению splify2, чтобы дойти до
# управляющего сокета (права файла проверяются раньше SELinux, и 0700 закрыл бы его и для
# splify2); читать и писать данные движка ему запрещает SELinux (steerd_data_file), а state и
# tmp — 0700. SELinux-метку steerd_data_file ставит file_contexts.
on post-fs-data
    mkdir /data/misc/steer 0711 root root
    mkdir /data/misc/steer/state 0700 root root
    mkdir /data/misc/steer/tmp 0700 root root
    restorecon_recursive /data/misc/steer

# Общее у служб движка:
#   group vpn        — /dev/tun ueventd создаёт как 0660 system:vpn (помощники выходов);
#   stdio_to_kmsg    — init отдаёт stdout и stderr служб в /dev/null, а журнал движка — это
#                      строки steer[warn]/steer[info] в stderr: с этой опцией они в dmesg;
#   gentle_kill      — stop шлёт SIGTERM и лишь через 200 мс SIGKILL: демон успевает погасить
#                      помощников и резолвер.

# Демон. ПОДНИМАЕТСЯ ПРИ КАЖДОЙ ЗАГРУЗКЕ, независимо от persist.der.steer.enabled: через его сокет
# приложение показывает состояние и сохраняет спеку и тогда, когда движок выключен (apply при
# выключенном движке только сохраняет). Выключатель приложение ставит само, свойством; домену
# движка писать его нельзя нарочно (steerd.te), читает его демон сам.
#
# Батарея: при выключенном движке у демона нет ни одного таймера — ни прохода сторожа, ни снимка
# состояния, ни стража правил; он спит в epoll_wait без срока до запроса по сокету. При
# включённом сроки — на CLOCK_MONOTONIC (во сне устройства стоят и не будят его), wakelock не
# берётся. --apply — при старте поставить сохранённую спеку, если движок включён.
#
# Сокет /data/misc/steer/steer.sock создаёт сам демон, а не опция `socket` у init: та кладёт
# сокет в /dev/socket, который листает любой домен (system/sepolicy, domain.te), то есть имя
# движка увидело бы любое приложение. Метку steerd_socket сокету ставит type_transition.
#
# Резолвер на телефоне переспрашивает тот сервер, к которому шёл запрос (умолчание платформы
# android в движке): на 127.0.0.1:53 здесь никто не слушает.
service steerd /system_ext/bin/der/steerd daemon --watch --supervise --apply
    class late_start
    user root
    group root net_admin net_raw inet vpn
    capabilities NET_ADMIN NET_RAW NET_BIND_SERVICE
    seclabel u:r:steerd:s0
    stdio_to_kmsg
    gentle_kill

# Сообщить демону о выключателе: `steer reload` по сокету. Включили — демон перечитывает спеку,
# ставит правила и заводит сторожа; выключили — гасит свои таймеры (правила снимает steerd-down
# после него, см. ниже).
service steerd-reload /system_ext/bin/der/steer reload
    class late_start
    user root
    group root net_admin net_raw inet vpn
    capabilities NET_ADMIN NET_RAW NET_BIND_SERVICE
    seclabel u:r:steerd:s0
    stdio_to_kmsg
    oneshot
    disabled

# Снятие правил при выключении: таблицы движка во всех раскладках, ip rule, маршруты выходов и
# masquerade в iptables. Разово, исполняемым файлом движка напрямую, не через сокет: снимать
# надо и тогда, когда демон упал.
service steerd-down /system_ext/bin/der/steerd down --state-dir /data/misc/steer/state
    class late_start
    user root
    group root net_admin net_raw inet vpn
    capabilities NET_ADMIN NET_RAW NET_BIND_SERVICE
    seclabel u:r:steerd:s0
    stdio_to_kmsg
    gentle_kill
    oneshot
    disabled

# Включение. stop steerd-down — на случай быстрого переключения 0 → 1, чтобы снятие не легло
# поверх только что поставленного. При загрузке этот триггер срабатывает на загрузке persist-
# свойств, раньше класса late_start: reload тогда не застаёт демона и ничего не делает, а
# сохранённую спеку ставит сам демон при старте (--apply).
on property:persist.der.steer.enabled=1
    setprop der.steer.phase on
    stop steerd-down
    start steerd-reload

# Выключение: сначала reload — демон гасит сторожа и стража правил, иначе страж вернул бы
# снятое, — и только по его окончании steerd-down. Порядок держит фаза der.steer.phase: она
# ставится ПОСЛЕ start steerd-reload, когда init уже записал reload в running, поэтому
# «off-reload && stopped» означает именно этот запуск, а не прошлый.
on property:persist.der.steer.enabled=0
    start steerd-reload
    setprop der.steer.phase off-reload

on property:der.steer.phase=off-reload && property:init.svc.steerd-reload=stopped
    setprop der.steer.phase off
    start steerd-down

# Триггера на перезапуск netd больше нет. netd при старте стирает все ip rule, кроме приоритета
# 0, и перестраивает свои цепочки iptables; демон видит пропажу своего правила 9000 событием
# netlink (RTM_DELRULE) и за секунду-две возвращает ip rule, таблицы выходов и masquerade сам —
# проверено в Cuttlefish на ядре GKI 6.12 (kill netd, вслед за ним перезапуск system_server).

# Дальше (не сделано): выделенный uid AID_STEER вместо root. Сейчас демон root, но заперт
# доменом steerd; на Android изоляцию даёт домен, а не uid, поэтому это улучшение, а не
# обязательное условие. Правка android_filesystem_config.h, отдельным коммитом.
