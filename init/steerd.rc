# steerd.rc — запуск движка steer под Android init.
#
# Это порт start_service из OpenWrt-скрипта files/etc/init.d/steer на язык init.rc. На
# роутере procd читает спеку и поднимает по экземпляру на каждый выход (vless, xsteer, obfs,
# zapret, tgws); в init.rc так нельзя — сервисы объявляются статически, а состав выходов
# известен только из спеки во время работы. Поэтому здесь заведены только процессы, которые
# есть при ЛЮБОЙ настройке: применение правил, резолвер доменов, сторож устройств и снятие
# правил при выключении, а помощников отдельных выходов (свой туннель) — сервис steerd-outputs.
#
# Пути отличаются от роутера и заданы сборкой через -DSTEER_ANDROID:
#   спека   /data/misc/steer/spec.json   (на роутере /etc/steer/spec.json)
#   состояние /data/misc/steer/state     (на роутере /var/lib/steer, tmpfs)
#   времянки /data/misc/steer/tmp        (на роутере /tmp)
# На роутере /var — ссылка в tmpfs, снимок состояния во флеш не пишется. На Android /data
# постоянный, поэтому состояние (реестр меток, выбранные устройства, fake-IP резолвера)
# ложится туда же.

# Каталоги создаём в post-fs-data: до этого /data не смонтирован. Корень — 0711: обходить его
# может любой uid, читать список — только root. Обход нужен приложению splify2, чтобы дойти до
# управляющего сокета (права файла проверяются раньше SELinux, и 0700 закрыл бы его и для
# splify2); читать и писать данные движка ему запрещает SELinux (steerd_data_file), а state и
# tmp — 0700. SELinux-метку steerd_data_file ставит file_contexts.
on post-fs-data
    mkdir /data/misc/steer 0711 root root
    mkdir /data/misc/steer/state 0700 root root
    mkdir /data/misc/steer/tmp 0700 root root
    restorecon_recursive /data/misc/steer

# Общее у всех сервисов движка:
#   group vpn        — /dev/tun ueventd создаёт как 0660 system:vpn (помощники выходов, apply);
#   stdio_to_kmsg    — init отдаёт stdout и stderr сервисов в /dev/null, а журнал движка — это
#                      строки steer[warn]/steer[info] в stderr: с этой опцией они в dmesg;
#   gentle_kill      — stop шлёт SIGTERM и лишь через 200 мс SIGKILL: сторож и супервизор
#                      успевают убрать за собой (правило пробы, помощников).

# Применение правил — разовое действие: собрать набор правил, отдать его ядру через nft,
# поставить ip rule и masquerade — и завершиться. Правила остаются в ядре сами.
service steerd-apply /system_ext/bin/der/steer apply --spec /data/misc/steer/spec.json
    class late_start
    user root
    group root net_admin net_raw inet vpn
    capabilities NET_ADMIN NET_RAW NET_BIND_SERVICE
    seclabel u:r:steerd:s0
    stdio_to_kmsg
    gentle_kill
    oneshot
    disabled

# Резолвер доменных каналов. Поднимается при любой спеке, как и на роутере (steer needs-dnsd
# отвечает «поднимать» всегда): перенаправление DNS стоит в правилах всегда, и резолвер, к
# которому оно ведёт, обязан существовать вместе с ним.
#
# --upstream-origdst: наверху у резолвера на телефоне никого нет (на 127.0.0.1:53 никто не
# слушает), поэтому каждый запрос уходит к тому серверу, к которому шёл до заворота, — адрес
# берётся из conntrack. Для раздачи это dnsmasq тетеринга, для приложений — серверы текущей
# сети, которые знает только DnsResolver.
service steerd-dnsd /system_ext/bin/der/steer dnsd --spec /data/misc/steer/spec.json --upstream-origdst
    class late_start
    user root
    group root net_admin net_raw inet vpn
    capabilities NET_ADMIN NET_RAW NET_BIND_SERVICE
    seclabel u:r:steerd:s0
    stdio_to_kmsg
    gentle_kill
    disabled

# Помощники выходов со своим процессом: клиент VLESS/Reality, xsteer, обфускатор, мост
# Telegram. Их состав зависит от спеки, а сервисы init объявлены статически, поэтому держит их
# один сервис — `steer supervise` (перезапуск упавшего через 5 с, падающего сразу — с растущей
# паузой до 5 минут; SIGHUP — сверить состав со спекой). Помощники исполняются в том же домене.
service steerd-outputs /system_ext/bin/der/steer supervise --spec /data/misc/steer/spec.json
    class late_start
    user root
    group root net_admin net_raw inet vpn
    capabilities NET_ADMIN NET_RAW NET_BIND_SERVICE
    seclabel u:r:steerd:s0
    stdio_to_kmsg
    gentle_kill
    disabled

# Сторож устройств. На роутере это `while :; do steer failover; sleep 60; done` экземпляром
# procd; здесь круг крутит сам движок (`--loop 60`), каждый проход — отдельный процесс.
# Проверяет по событиям ядра (смена интерфейса или адреса — внеочередной проход) и по периоду
# для того, чего событием не увидеть. Ожидание — на CLOCK_MONOTONIC: во сне устройства оно
# стоит и не будит его; wakelock сторож не берёт.
service steerd-failover /system_ext/bin/der/steer failover --loop 60 --spec /data/misc/steer/spec.json
    class late_start
    user root
    group root net_admin net_raw inet vpn
    capabilities NET_ADMIN NET_RAW NET_BIND_SERVICE
    seclabel u:r:steerd:s0
    stdio_to_kmsg
    gentle_kill
    disabled

# Снятие правил при выключении — разовое, как и применение: таблицы движка во всех раскладках,
# ip rule, маршруты выходов, правило пробы и masquerade в iptables.
service steerd-down /system_ext/bin/der/steer down --state-dir /data/misc/steer/state
    class late_start
    user root
    group root net_admin net_raw inet vpn
    capabilities NET_ADMIN NET_RAW NET_BIND_SERVICE
    seclabel u:r:steerd:s0
    stdio_to_kmsg
    gentle_kill
    oneshot
    disabled

# Включение по свойству. splify2 ставит persist.der.steer.enabled=1 — и init поднимает всё
# сразу: start не ждёт окончания oneshot, так что помощники, apply, резолвер и сторож стартуют
# вместе. Порядок им и не нужен: TUN помощника, появившийся после apply, сторож видит событием
# ядра и привязывает, а до того трафик выхода держит on_fail (blackhole или напрямую).
# stop steerd-down — на случай быстрого переключения 0 → 1, чтобы снятие не легло поверх
# только что поставленного.
on property:persist.der.steer.enabled=1
    stop steerd-down
    start steerd-outputs
    start steerd-apply
    start steerd-dnsd
    start steerd-failover

# netd при старте стирает ВСЕ ip rule, кроме приоритета 0 (RouteController::Init → flushRules),
# и заново строит свои цепочки iptables — то есть наши правила 9000 и masquerade. При загрузке
# порядка между netd и нашим apply нет, поэтому apply повторяется после загрузки и после
# каждого (пере)запуска netd. Сторож и сам возвращает ip rule и masquerade на каждом проходе.
on property:sys.boot_completed=1 && property:persist.der.steer.enabled=1
    start steerd-apply
on property:init.svc.netd=running && property:persist.der.steer.enabled=1
    start steerd-apply

# Выключение: гасим демонов и снимаем правила. Перезапуск демона правил нарочно не трогает
# (открыть трафик на мгновение перезапуска хуже, чем подержать правила), но выключение —
# другое: резолвер погашен насовсем, и заворот DNS на его порт, оставшись в ядре, лишил бы
# имён всех, чей DNS заворачивался; blackhole выхода с on_fail=drop держал бы трафик закрытым
# без видимой причины. При выключенном движке это срабатывает и на каждой загрузке — снимать
# тогда нечего, и steer down просто ничего не находит.
on property:persist.der.steer.enabled=0
    stop steerd-failover
    stop steerd-dnsd
    stop steerd-outputs
    start steerd-down

# Дальше (не сделано): выделенный uid AID_STEER вместо root. Сейчас демон root, но заперт
# доменом steerd; на Android изоляцию даёт домен, а не uid, поэтому это улучшение, а не
# обязательное условие. Правка android_filesystem_config.h, отдельным коммитом.
