# Домен приложения splify2 — единственной двери к движку.
#
# Приложение ставится в system_ext/priv-app на платформенной подписи и попадает сюда по
# seapp_contexts (имя пакета и seinfo=platform). Само приложение — apps/Splify2 (договор частей
# — apps/Splify2/BRIDGE.md); домен задан раньше него, и оно написано под эту политику.
#
# Сверх перечисленного ниже приложению ничего не понадобилось, и это проверено по тому, что
# оно делает: настройки Private DNS (Settings.Global) пишет system_server по разрешению Android
# WRITE_SECURE_SETTINGS, а не SELinux; JobScheduler, ConnectivityManager, PackageManager,
# TelephonyManager (имя оператора: служба isub и свойства gsm.*, читаемые любым coredomain) —
# службы app_api_service; WebView — как у любого приложения (app_domain); свои файлы —
# app_data_file по seapp_contexts. Прочитать выключатель движка даёт set_prop (в нём get_prop).
#
# Образец — traceur_app: платформенное приложение в своём домене получает app_domain (всё, что
# есть у любого приложения) и сверх него ровно то, что нужно для его дела, — а не весь набор
# platform_app. Здесь это: системные службы (по ним приложение узнаёт UID других приложений и
# состояние сети), сеть (скачивание списков и подписок), выключатель движка и его сокет.

type splify2_app, domain, coredomain;
app_domain(splify2_app)
net_domain(splify2_app)

# Единственная дверь: подключиться к управляющему сокету движка. Больше splify2 к движку
# ничего не нужно — ни файлы, ни процесс. За сокетом — демон `steerd daemon` (служба
# steerd): status, diag, explain, apply и check со спекой в теле запроса, reload, пробы
# узлов VLESS (протокол — docs/ctl.md в дереве steer). Сервер сам проверяет собеседника: этот
# домен он узнаёт по контексту SELinux (SO_PEERSEC), а не по uid, которого заранее не знать.
allow splify2_app steerd_socket:sock_file { read write getattr };
# Дойти до сокета: /data/misc обходит любой домен (domain.te), а каталог движка — только мы.
allow splify2_app steerd_data_file:dir search;
allow splify2_app steerd:unix_stream_socket connectto;

# Системные службы, которые видит любое приложение (app_api_service), и те, что открыты
# платформенным (system_api_service): PackageManager — список приложений и их UID для каналов
# «на приложение», ConnectivityManager — смена сети. Те же две строки есть у priv_app и
# platform_app; сверх них у platform_app медиа, камера и радио — splify2 они не нужны.
allow splify2_app { app_api_service system_api_service }:service_manager find;

# Включить или выключить движок: init следит за persist.der.steer.enabled (см. steerd.rc).
set_prop(splify2_app, steerd_prop)
