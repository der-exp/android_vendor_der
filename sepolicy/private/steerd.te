# Правила домена steerd — приватная политика system_ext.
#
# Задача домена двойная: (1) дать демону ровно те права, что нужны движку маршрутизации
# поверх nftables, и ничего сверх; (2) сделать движок недоступным для всех приложений, кроме
# splify2 — это прямое требование владельца («steer невидим для всех приложений, кроме
# splify2»). Невидимость здесь означает не сокрытие процесса (его и так прячет hidepid=2 на
# /proc у Android), а недоступность: у чужого приложения нет ни одного allow на наши типы, а
# значит любое обращение к бинарнику, конфигу, сокету или процессу steerd — отказ на уровне
# ядра.

# Каталог /system_ext/bin/der, где лежит движок. Тип приватный: на него не ссылается никто,
# кроме этой политики. Приложениям платформа разрешает обходить только system_file
# (app.te: system_file:dir r_dir_perms), поэтому каталог со своим типом для них закрыт:
# имя der в /system_ext/bin видно, а что внутри и какие у файла атрибуты — нет.
type steerd_bin_dir, file_type, system_file_type;

# Точка входа: запуск steerd_exec переводит процесс в домен steerd. init_daemon_domain даёт
# домену право быть поднятым из init и базовые права демона.
init_daemon_domain(steerd)

# Базовые сетевые права домена (сокеты, resolv и т.п.) — тем же макросом, что у dnsmasq и
# прочих сетевых демонов платформы.
net_domain(steerd)

# --- права, которые нужны движку ------------------------------------------------------

# Возможности: NET_ADMIN — грузить правила nft, ставить ip rule/route, создавать TUN;
# NET_RAW — сырые сокеты (пинг сторожа, разбор пакетов); NET_BIND_SERVICE — резолвер слушает
# привилегированный порт, если так настроено (по умолчанию 5300, но право не лишнее).
allow steerd self:global_capability_class_set { net_admin net_raw net_bind_service };

# nfnetlink — этим движок и dnsd говорят с nf_tables (загрузка таблиц, добавление элементов
# в наборы). Это ключевой сокет: без него нет ни apply, ни подмены адресов резолвером.
allow steerd self:netlink_netfilter_socket { create bind write read setopt getopt };

# netlink route — ip rule/route и чтение состояния интерфейсов сторожем.
allow steerd self:netlink_route_socket { create bind write read setopt getopt nlmsg_read nlmsg_write nlmsg };

# ЗАДЕЛ НА policycap netlink_xperm (ядро 6.13 и новее; в lineage-23.2 не включён). С этой
# возможностью ядро проверяет сообщения netlink не парой nlmsg_read/nlmsg_write, а правом nlmsg
# с расширенным списком типов сообщений, — и тогда домену остаётся только список netdomain
# (net.te: unpriv_route_socket_nlmsgs — одни RTM_GET*, без RTM_GETLINK), то есть ни ip rule, ни
# маршрута выхода, ни адреса TUN движок поставить бы не смог. Здесь — ровно то, что зовёт
# движок: `ip rule add/del/show`, `ip route add/replace/flush/show` (flush — это дамп и
# RTM_DELROUTE), `ip addr replace` (адрес TUN), `ip link set` (поднять TUN; ip при этом
# спрашивает индекс устройства через RTM_GETLINK), и RTM_GETLINK/RTM_GETADDR сторожа.
# netd берёт весь диапазон (priv_route_socket_nlmsgs); нам столько не нужно.
#
# Без возможности эти строки ничего не меняют: правило allowxperm с nlmsg действует, только
# когда её включила политика и её знает ядро (4.9 телефона не знает вовсе). Компилируется
# checkpolicy/secilc платформы и сейчас — тем же синтаксисом платформа пишет права netd и dhcp.
#
# netlink_netfilter_socket (nftables и ctnetlink — загрузка правил, элементы наборов, снятие
# соединений conntrack) списков не требует: ядро проверяет типы сообщений только у сокетов
# route, tcpdiag, xfrm и audit (security/selinux/nlmsgtab.c), у netfilter — нет. tcpdiag,
# xfrm и audit движок не открывает.
allowxperm steerd self:netlink_route_socket nlmsg {
    RTM_NEWLINK RTM_DELLINK RTM_GETLINK RTM_SETLINK
    RTM_NEWADDR RTM_DELADDR RTM_GETADDR
    RTM_NEWROUTE RTM_DELROUTE RTM_GETROUTE
    RTM_NEWRULE RTM_DELRULE RTM_GETRULE
};

# Резолвер dnsd слушает UDP/TCP и ходит к апстриму. tun_socket + /dev/tun — для выходов,
# которые поднимают свой туннель (vless/xsteer): движок сам создаёт TUN и привязывает к нему
# таблицу маршрутизации.
allow steerd self:{ udp_socket tcp_socket } { create bind connect read write setopt getopt getattr shutdown };
allow steerd self:tun_socket { create };
allow steerd tun_device:chr_file rw_file_perms;
# ioctl на /dev/tun платформа сужает списком (domain.te: allowxperm … { FIOCLEX FIONCLEX }), и
# без своего списка создать устройство нельзя. Ровно то, что зовёт src/ext/tun.c: TUNSETIFF
# (создать/открыть устройство), TUNSETOFFLOAD (GRO у xsteer), и TUNGETIFF, как у netd.
allowxperm steerd tun_device:chr_file ioctl { TUNSETIFF TUNSETOFFLOAD TUNGETIFF };

# Сторож читает состояние устройств выходов: /sys/class/net/<dev>/operstate, carrier, mtu.
# Без этого права каждый выход выглядел бы отсутствующим — и упавшим (blackhole при
# on_fail=drop, напрямую при остальных).
r_dir_file(steerd, sysfs_net)

# Проба сторожа — ping через устройство выхода (/system/bin/ping), и masquerade у выходов-
# интерфейсов — правилом iptables (см. android_masq_sync в steer.c: на ядре 4.9 nat nft и nat
# iptables netd на одном хуке не уживаются). iptables говорит с ядром через сырой сокет и
# берёт блокировку /system/etc/xtables.lock, как netd.
allow steerd self:rawip_socket { create getopt setopt read write };
allow steerd self:icmp_socket { create getopt setopt read write connect };
allow steerd system_file:file lock;

# nft вызывается движком как внешняя команда. Бинарник nft помечен steerd_exec (см.
# file_contexts) и исполняется В ТОМ ЖЕ домене steerd (execute_no_trans): отдельный домен для
# nft ничего не изолировал бы — nft делает ровно то, что ему поручил движок, и его права —
# подмножество прав движка.
allow steerd steerd_exec:file { read execute execute_no_trans open getattr };

# ip вызывается движком (ip rule/route/link). ip лежит в /system/bin (тип system_file) и на
# Android исполняется в домене вызывающего — разрешаем это явно.
allow steerd system_file:file execute_no_trans;

# Корни сертификатов для клиента VLESS/TLS (security=tls): движок склеивает каталог
# /apex/com.android.conscrypt/cacerts (запасной — /system/etc/security/cacerts) в файл
# своего состояния, потому что certverify читает хранилище одним файлом. Читать сами файлы
# платформа разрешает любому домену (domain.te); листать каталог — нет, это право здесь.
allow steerd system_security_cacerts_file:dir r_dir_perms;

# Уровень MLS. Приложение splify2 живёт на уровне своего пользователя и приложения
# (levelFrom=all в seapp_contexts), демон — на s0; ограничения MLS на connectto и запись в
# сокет (private/mls) без доверенного субъекта или объекта с одной стороны закрыли бы канал.
typeattribute steerd mlstrustedsubject;

# Журнал: stdout и stderr сервисов init отдаёт в /dev/null, а у сервисов steerd стоит
# stdio_to_kmsg — строки steer[warn]/steer[info] видны в dmesg.
allow steerd kmsg_device:chr_file { write open getattr };

# Данные движка: спека, списки, снимок, сокет, времянки. Полный доступ в своём каталоге.
allow steerd steerd_data_file:dir  create_dir_perms;
allow steerd steerd_data_file:file create_file_perms;
allow steerd steerd_data_file:lnk_file { create read getattr unlink };

# Управляющий сокет. Файл сокета, созданный процессом, получает тип КАТАЛОГА, в котором
# создан, а не тот, что написан в file_contexts: file_contexts применяет restorecon, а
# сокет появляется уже после него, при каждом старте демона. Без перехода ниже сокет
# родился бы steerd_data_file — и splify2, которому разрешён ровно steerd_socket, получил
# бы отказ, а разрешать ему весь каталог данных значило бы сломать запрет ниже.
type_transition steerd steerd_data_file:sock_file steerd_socket "steer.sock";
# write — для connect: сервер при старте пробует подключиться к прежнему файлу сокета, чтобы
# не отнять его у живого соседа (src/ctl.c, ctl_listen), и так же подключается `steer ctl`,
# запущенный в этом домене.
allow steerd steerd_socket:sock_file { create setattr unlink getattr write };

# Сокет журнала резолвера (<каталог состояния>/dnsd.sock, права 0600): его создаёт steer-dnsd,
# а подключается к нему сервер управляющего сокета, отвечая приложению на dns-log (docs/ctl.md
# дерева steer). Оба — домен steerd, и файл сокета получает тип каталога, steerd_data_file.
# Перехода в свой тип, как у steer.sock, ему не нужно нарочно: приложению он не должен быть
# виден вовсе, и запрет ниже (neverallow … steerd_data_file) это держит. write — для connect.
allow steerd steerd_data_file:sock_file { create unlink getattr write };

# Сервер сокета (steer ctl-serve) и сам сокет: слушать и принимать (listen, accept) и узнать
# собеседника (getopt: SO_PEERCRED, SO_PEERSEC) — это всё права на СВОЙ сокет, их даёт
# domain.te всем доменам (self:unix_stream_socket create_stream_socket_perms). reload находит
# резолвер и супервизор по /proc/<pid>/exe и посылает им SIGHUP/SIGTERM — тоже только внутри
# своего домена (domain.te: r_dir_file(domain, self), self:process signal), чужие процессы
# домену не видны. Своих строк для этого здесь поэтому нет.

# Каталог /system_ext/bin/der — свой тип (см. file_contexts): его могут обходить только init
# (запуск сервиса) и сам демон.
allow { init steerd } steerd_bin_dir:dir r_dir_perms;

# Свойство-выключатель демон читает (нужно ли работать) — писать его он не должен, пишут init
# и splify2.
get_prop(steerd, steerd_prop)

# --- сокрытие движка от чужих приложений ---------------------------------------------
#
# Всё, что ниже, — гарантии, а не разрешения. domain по умолчанию не имеет доступа к нашим
# типам; neverallow превращает это из «по умолчанию нет» в «нельзя добавить и потом», то есть
# ловит будущую ошибку в политике на этапе сборки.

# Процесс steerd недосягаем для приложений: ни трейснуть, ни послать сигнал, ни даже снять
# атрибуты. splify2 исключён из запрета — с ним движок общается, но и ему процесс не нужен
# (канал — сокет), поэтому по умолчанию не даём и ему; исключение оставлено на случай, если
# splify2 понадобится, например, проверить, жив ли демон.
#
# shell из запрета исключён. Это adb shell: платформа даёт ему getattr на процесс любого
# домена (так работает `ps -A`), и запрет без исключения ломал сборку политики. Отнимать это
# у adb shell — правка платформенной политики ради отладочного входа, который у человека и так
# есть только при включённой отладке по USB; приложения сюда не входят.
neverallow { appdomain -splify2_app -shell } steerd:process { ptrace signal sigkill sigstop getattr getsched };

# Данные, бинарник и сокет движка недоступны любому приложению, кроме splify2. splify2 ходит
# только в сокет (см. splify2_app.te), но не в файлы — ему хватает сокета.
neverallow { appdomain -splify2_app } steerd_data_file:{ dir file } *;
neverallow { appdomain -splify2_app } steerd_socket:sock_file ~getattr;
neverallow { appdomain } steerd_exec:file { execute execute_no_trans };
neverallow { appdomain } steerd_bin_dir:dir { search read open };

# Свойство-выключатель приложение писать не может — иначе любое приложение включало бы или
# гасило движок.
neverallow { appdomain -splify2_app } steerd_prop:property_service set;
